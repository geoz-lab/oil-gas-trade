# Copy this to .env and fill in your keys
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Optional — enhances data retrieval but system works without them
ALPHA_VANTAGE_KEY="your_alpha_vantage_key_here"   # https://www.alphavantage.co/support/#api-key
EIA_API_KEY="your_eia_api_key_here"               # https://www.eia.gov/opendata/register.php
NEWSAPI_KEY="your_newsapi_key_here"               # https://newsapi.org/register
